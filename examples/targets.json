{
  "targets": [
    {
      "name": "example-web",
      "kind": "http",
      "url": "https://example.com",
      "expect_status": 200,
      "timeout": 5
    },
    {
      "name": "example-https-port",
      "kind": "tcp",
      "host": "example.com",
      "port": 443,
      "timeout": 5
    },
    {
      "name": "example-dns",
      "kind": "dns",
      "hostname": "example.com",
      "timeout": 5
    }
  ]
}
